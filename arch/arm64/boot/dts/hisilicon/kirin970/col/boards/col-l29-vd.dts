/dts-v1/;

/include/ "../variants/col-l29.dtsi"

/ {
	hisi,boardid = <0x06 0x08 0x01 0x09>;
	hisi,boardname = "COL_L29_VD";
	hisi,modem_id = "9a`";

	pinmux@fff11000 {
		gpio195_pmx_func {
			pinctrl-single,pins = <0x44 0x00>;
		};

		gpio195_pmx_idle {
			pinctrl-single,pins = <0x44 0x00>;
		};

		gpio196_pmx_func {
			pinctrl-single,pins = <0x48 0x00>;
