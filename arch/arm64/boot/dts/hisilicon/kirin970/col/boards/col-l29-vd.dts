				nfc_nxp_name = "libnfc-nxp.conf";
				nfc_card_num = <0x02>;
				nfc_chip_type = "pn551";
			};
		};
	};

	hw_antenna_board_match {
		compatible = "huawei,antenna_board_match";
		status = "ok";
		phandle = <0x4cf>;
	};

	antenna_board_adc_match {
