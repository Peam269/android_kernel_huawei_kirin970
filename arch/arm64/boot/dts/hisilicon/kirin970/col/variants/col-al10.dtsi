/include/ "../col-common.dtsi"

/ {
	hisi,product_name = "COL-AL10";

	pinmux@fff11000 {
		gpio195_pmx_func {
			pinctrl-single,pins = <0x44 0x01>;
		};

		gpio195_pmx_idle {
			pinctrl-single,pins = <0x44 0x01>;
		};

		gpio196_pmx_func {
			pinctrl-single,pins = <0x48 0x01>;
		};

		gpio196_pmx_idle {
			pinctrl-single,pins = <0x48 0x01>;
