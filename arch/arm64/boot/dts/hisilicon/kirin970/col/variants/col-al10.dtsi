		gpio197_pmx_func {
			pinctrl-single,pins = <0x4c 0x01>;
		};

		gpio197_pmx_idle {
			pinctrl-single,pins = <0x4c 0x01>;
		};
	};

	pinmux@fff11800 {
		gpio217_cfg_func {
			pinctrl-single,bias-pulldown = <0x02 0x02 0x00 0x02>;
			pinctrl-single,bias-pullup = <0x00 0x01 0x00 0x01>;
		};

		gpio217_cfg_idle {
			pinctrl-single,bias-pulldown = <0x02 0x02 0x00 0x02>;
			pinctrl-single,bias-pullup = <0x00 0x01 0x00 0x01>;
		};
	};

