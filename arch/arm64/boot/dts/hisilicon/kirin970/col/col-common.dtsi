	amba {
		phandle = <0x477>;

		i2c@FFD71000 {
			phandle = <0x478>;
		};

		i2c@FFD72000 {
			phandle = <0x479>;

			rt9748@67 {
				status = "disabled";
				phandle = <0x47a>;
			};

			fusb30x_i2c1@22 {
				status = "ok";
				fairchild,int_n = <0x2c 0x05 0x00>;
			};

			tusb422_i2c1@20 {
				status = "ok";
				ti,alert-gpio = <0x2c 0x05 0x00>;
			};

			rt1711_i2c1@4e {
				status = "ok";
				rt1711,irq_pin = <0x2c 0x05 0x00>;

				pd-data {
					pd,id-vdo-size = <0x04>;
					pd,id-vdo-data = <0xec0012d1 0x00 0x107e0000 0x11000001>;
				};
			};
		};

		i2c@FFD73000 {
			clocks = <0x2d 0x28>;
			phandle = <0x47b>;
		};

		i2c@FDF0C000 {
			clocks = <0x2e 0x28>;
			status = "ok";
			clock-rate = <0x00 0x69db9c0>;
			pinctrl-names = "default", "idle";
			pinctrl-0 = <0x2f 0x30 0x31 0x32>;
			pinctrl-1 = <0x33 0x34 0x35 0x36>;
			cs-gpios = <0x37 0x06 0x00 0x37 0x07 0x00>;
			phandle = <0x47c>;

			bq25892_charger_aux@6B {
				gpio_cd = <0x37 0x07 0x00>;
				gpio_int = <0x38 0x06 0x00>;
				phandle = <0x47d>;
			};

			ti,lm36923 {
				compatible = "huawei,hw_lm36923", "huawei,hw_mp3313";
				status = "ok";
			};

			max77813@18 {
				gpio_pok = <0x2b 0x03 0x00>;
				reg = <0x18>;
				phandle = <0x47e>;
			};

			nfc@28 {
				status = "ok";
				nfc_on_type = "gpio";
				clk_status = "pmu_hi6421v600";
				pn547,dload = <0x39 0x06 0x00>;
				pn547,irq = <0x3a 0x01 0x00>;
				pn547,ven = <0x3b 0x00 0x00>;
				pinctrl-names = "default", "idle";
				pinctrl-0 = <0x3c 0x3d 0x3e 0x3f 0x40>;
				pinctrl-1 = <0x41 0x42 0x43 0x44 0x45>;
				clock-names = "clk_out0";
				clocks = <0x46>;
				reg = <0x28>;
				compatible = "hisilicon,pn547_nfc";
				nfc_single_channel = "true";
				nfc_ese_type = "hisee";
				phandle = <0x47f>;
			};
		};

