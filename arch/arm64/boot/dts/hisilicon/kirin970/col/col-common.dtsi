	a1@0xFF012000 {
		clocks = <0x1e1 0x1e2 0x1e3>;
	};

	hisi,memlat-cpu4@fff31000 {
		phandle = <0x241>;
	};

	hisi,arm-memlat-mon-4 {
		hisi,target-dev = <0x241>;
	};

	hi1102 {
		compatible = "hisilicon,hi1102";
		huawei,pmu_clk32b = "pmu_clk32kb";
		hi1102,gpio_power_on = <0x1d7 0x07 0x00>;
		pinctrl-names = "default", "idle";
		pinctrl-0 = <0x242 0x243 0x244 0x245 0x246 0x247>;
		pinctrl-1 = <0x248 0x249 0x24a 0x24b 0x24c 0x24d>;
		hi1102,asic_version;
		hi1102,power_prepare;
		hi1102,gpio_bfgn_ir_ctrl = <0x1d7 0x04 0x00>;
		hi1102,gpio_xldo_pinmux = <0x5b 0x05 0x00>;
		xldo_gpio_level = <0x01>;
	};

	hisi_wifi {
		compatible = "hisilicon,hisi_wifi";
		hi1102,gpio_wlan_wakeup_host = <0x2b 0x05 0x00>;

		hisi_wifi_firmware {
			compatible = "hisi,wifi_firmware";
			firmware_type_num = "1";
		};

		hisi_wifi_supp {
			compatible = "hisi,wifi_supp";
			supp_config_template = "/vendor/etc/wifi/wpa_supplicant_hisi.conf";
		};

		hisi_wifi_p2p {
			compatible = "hisi,wifi_p2p";
			p2p_config_template = "/vendor/etc/wifi/p2p_supplicant_hisi.conf";
		};

		hisi_wifi_apd {
			compatible = "hisi,wifi_hostapd";
			hostapd_bin_file = "/vendor/bin/hostapd_hisi";
		};
	};

	hisi_bfgx {
		compatible = "hisilicon,hisi_bfgx";
		hi1102,gpio_bfgn_wakeup_host = <0x2c 0x02 0x00>;
		hi1102,uart_port = "/dev/ttyAMA4";
		hi1102,uart_pclk_normal;
		hi1102,irled_power_type = <0x00>;
		have_ir;
	};

	devcheck {
		touch_panel = <0x00>;
		compass = <0x00>;
		g_sensor = <0x00>;
		gyroscope = <0x00>;
		nfc = <0x00>;
		dc_dc = <0x00>;
		tps = <0x00>;
		l_sensor = <0x00>;
		charge = <0x00>;
		usb_switch = <0x00>;
		airpress = <0x00>;
		vibrator_lra = <0x00>;
		laser = <0x00>;
		charge_loadswitch = <0x00>;
	};

	hall {
		huawei,hall_0 {
			huawei,single-n-pole = <0x2c 0x01 0x00>;
			huawei,type = <0x01>;
			huawei,default-state = "on";
		};
	};

	irda_maxim {
		gpio_power_control = <0x24e 0x00 0x00>;
		status = "disabled";
	};

	pd_dpm {
		switch_manual_enable = <0x01>;
		support_dp = <0x01>;
		abnormal_cc_detection = <0x00>;
	};

	huawei_usb {
		maximum-speed = "high-speed";
	};

	huawei_usbvbus {
		support_pd = <0x01>;
		support_dp = <0x00>;
	};

	bluetooth_power {
		huawei,bt_en = <0x6f>;
		clocks = <0x24f>;
		status = "disabled";
	};

	bluetooth_sleep {
		huawei,bt_wake_host = <0xd5>;
		huawei,host_wake_bt = <0x48>;
		status = "disabled";
	};

	sec_pinmux@fff11800 {
		gpio213_cfg_func {
			pinctrl-single,pins = <0x710 0x00>;
			pinctrl-single,bias-pulldown = <0x00 0x02 0x00 0x02>;
			pinctrl-single,bias-pullup = <0x00 0x01 0x00 0x01>;
			pinctrl-single,drive-strength = <0x30 0x70>;
			pinctrl-single,slew-rate = <0x00 0x80>;
		};

		gpio213_cfg_idle {
			pinctrl-single,pins = <0x710 0x00>;
