				nfc_nxp_name = "libnfc-nxp.conf";
				nfc_card_num = <0x03>;
				clk_status = "pmu_hi6421v600";
				pinctrl-names = "default", "idle";
				clock-names = "clk_out0";
				reg = <0x28>;
				compatible = "hisilicon,pn547_nfc";
				nfc_chip_type = "pn551";
				nfc_single_channel = "true";
