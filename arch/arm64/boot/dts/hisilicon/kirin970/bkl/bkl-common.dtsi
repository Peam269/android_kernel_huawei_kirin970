		i2c@FDF0C000 {
			status = "ok";
			clock-rate = <0x00 0x69db9c0>;
			pinctrl-names = "default", "idle";
			phandle = <0x47b>;

			bq25892_charger_aux@6B {
				phandle = <0x47c>;
			};

