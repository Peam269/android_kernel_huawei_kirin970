			hi6421v600_coul_spmi@1 {
				compatible = "hisilicon,pmic6xxx_coul";
				interrupts = <0x09 0x00>;
				interrupt-names = "coulirq";
				status = "ok";
			};

			pmic_led@a0 {
				compatible = "hisilicon-hisi-led-pmic-spmi";
				status = "ok";
				hisilicon,dr_led_ctrl = <0x12f>;
				hisilicon,dr_out_ctrl = <0x133>;

				led@a0 {
					compatible = "hisilicon,hisi-led0";
					hisilicon,dr_ctrl = "red";
					hisilicon,dr_start_del = <0x134>;
					hisilicon,dr_iset = <0x130>;
					hisilicon,dr_time_config0 = <0x137>;
					hisilicon,dr_time_config1 = <0x138>;
				};

				led@a1 {
					compatible = "hisilicon,hisi-led1";
					hisilicon,dr_ctrl = "green";
					hisilicon,dr_start_del = <0x135>;
					hisilicon,dr_iset = <0x131>;
					hisilicon,dr_time_config0 = <0x139>;
					hisilicon,dr_time_config1 = <0x13a>;
				};

				led@a2 {
					compatible = "hisilicon,hisi-led2";
					hisilicon,dr_ctrl = "blue";
					hisilicon,dr_start_del = <0x136>;
					hisilicon,dr_iset = <0x132>;
					hisilicon,dr_time_config0 = <0x13b>;
					hisilicon,dr_time_config1 = <0x13c>;
				};
			};

			pmic_rtc@a0 {
				compatible = "hisilicon-hisi-rtc-spmi";
				interrupts = <0x03 0x00>;
				interrupt-names = "hisi-pmic-rtc";
				hisilicon,pmic-rtc-base = <0x340>;
				hisilicon,pmic-rtc-imr = <0x202>;
				hisilicon,pmic-rtc-icr = <0x212>;
				hisilicon,pmic-rtc-ib = <0x03>;
				hisilicon,pmic-rtc-xo-thrshd-pwroff-val = <0xffff>;
				status = "ok";

				soc_rtc@a0 {
					compatible = "hisilicon,soc-rtc";
					soc-rtc-baseaddr = <0xfff04000>;
					interrupt-parent = <0x01>;
					interrupts = <0x00 0x2e 0x04>;
				};
			};

			sim0 {
				compatible = "hisilicon-sim-hotplug0";
				sim_id = <0x00>;
				status = "ok";
				func_sel_state = "not_use_multi_func";
				det_normal_direction = "closed";
				hpd_debounce_wait_time = <0x00>;
				interrupts = <0x0b 0x00>;
				interrupt-names = "hpd0_falling";
				pmu_irq_mask3_address = <0x203>;
				pmu_irq3_address = <0x213>;
				pmu_irq_mask_address = <0x203>;
				pmu_irq_address = <0x213>;
				send_card_out_msg_when_init = <0x00>;
			};

			sim1 {
				compatible = "hisilicon-sim-hotplug1";
				sim_id = <0x01>;
				func_sel_state = "not_use_multi_func";
				det_normal_direction = "closed";
				allocate_gpio = <0x00>;
				shared_det_irq = <0x00>;
				send_msg_to_cp = <0x00>;
				card_tray_style = <0x00>;
				hpd_interrupt_to_close_ldo = <0x00>;
				hpd_debounce_wait_time = <0x00>;
				det_debounce_wait_time = <0x00>;
				interrupts = <0x0d 0x00>;
				interrupt-names = "hpd1_falling";
				pmu_status1_address = <0x00>;
				pmu_ldo11_onoff_eco_address = <0x00>;
				pmu_ldo11_vset_address = <0x00>;
				pmu_ldo12_onoff_eco_address = <0x00>;
				pmu_ldo12_vset_address = <0x00>;
				pmu_sim_ctrl_address = <0x00>;
				pmu_sim_deb_ctrl_address = <0x00>;
				pmu_irq_mask3_address = <0x203>;
				pmu_irq3_address = <0x213>;
				pmu_irq_mask_address = <0x203>;
				pmu_irq_address = <0x213>;
				pmu_ldo11_onoff_value = <0x00>;
				pmu_ldo11_vset_value = <0x00>;
				pmu_ldo12_onoff_value = <0x00>;
				pmu_ldo12_vset_value = <0x00>;
				send_card_out_msg_when_init = <0x00>;
			};
		};

		subpmic@6 {
			compatible = "hisilicon-hisi-6423-pmic-spmi";
			slave_id = <0x06>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			hisilicon,hisi-subpmic-irq-addr = <0x0a>;
			hisilicon,hisi-subpmic-irq-mask-addr = <0x0d>;
			hisilicon,hisi-subpmic-irq-np-record = <0x80>;
			bigfreq-limit-channel = "big-freq", "vote-src-2";
			gpufreq-limit-channel = "gpu-freq", "vote-src-2";
		};
	};

	firmware {
		android {
			compatible = "android,firmware";
			boot_devices = "ff3c0000.ufs";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,kernel,ramdisk,eng_system,eng_vendor,vbmeta_system,vbmeta_vendor,vbmeta_odm,vbmeta_hw_product,vbmeta_cust,version,preload,preas,preavs,prets,pretvs";
				ta_parts = "kernel,ramdisk,vbmeta_system,vbmeta_vendor,vbmeta_odm,vbmeta_hw_product,preas,preavs,vbmeta_cust";
			};

			fstab {
				compatible = "android,fstab";

				system_ext4 {
					mnt_point = "/system";
					dev = "system";
					type = "ext4";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				system_erofs {
					mnt_point = "/system";
					dev = "system";
					type = "erofs";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				vendor_ext4 {
					mnt_point = "/vendor";
					dev = "vendor";
					type = "ext4";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				vendor_erofs {
					mnt_point = "/vendor";
					dev = "vendor";
					type = "erofs";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				odm_ext4 {
					mnt_point = "/odm";
					dev = "odm";
					type = "ext4";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				odm_erofs {
					mnt_point = "/odm";
					dev = "odm";
					type = "erofs";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				cust_ext4 {
					mnt_point = "/cust";
					dev = "cust";
					type = "ext4";
