	a1@0xFF012000 {
		compatible = "hisilicon,hisi-perfstat-driver";
		reg = <0x00 0xfdf10000 0x00 0x1000>;
		interrupts = <0x00 0x7f 0x04>;
		clock-names = "clk_perf_stat", "aclk_perf_stat", "pclk_perf_stat";
		suggest_clk = <0x7270e00>;
		suggest_aclk = <0xe2f9780>;
		hisilicon,perf-event-id = <0x80000000>;
		hisilicon,per-data-size = <0x20>;
		hisilicon,vldmsk-of-sprt = <0x5fefffff>;
		hisilicon,qos_support = <0x01>;
		hisilicon,rs_enable_support = <0x02>;
		hisilicon,rs_support_port = <0x7c 0x840980 0x80 0x5e03e600>;
	};

	target-cpu {
		compatible = "hisi,targetcpu";
		target_cpu = "Kirin 970";
	};

	cpu-idle-flag {
		compatible = "hisilicon,cpu-idle-flag";
		idle-reg-base = <0xfff0a000>;
		core-0-flag = <0x42c 0x00>;
		core-1-flag = <0x42c 0x01>;
		core-2-flag = <0x42c 0x02>;
		core-3-flag = <0x42c 0x03>;
		core-4-flag = <0x430 0x00>;
		core-5-flag = <0x430 0x01>;
		core-6-flag = <0x430 0x02>;
		core-7-flag = <0x430 0x03>;
	};

	support-target {
		compatible = "hisi,supportedtarget";
		support_name = "Kirin 970", "Kirin 975";
		support_value = <0x258190 0x1d76f8>;
		support_efuse = "false";
	};

	idle-sleep {
		compatible = "hisilicon,idle-sleep";
		vote-addr = <0xfff0a410>;
		status = "ok";
	};

	menu-switch {
		compatible = "hisi,menu-switch";
		cpu-mask = <0x00 0xf0>;
		switch-profile = <0xa6810>;
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
		system_off = <0x84000008>;
		system_reset = <0x84000009>;
	};

	l2_retention_freq {
		compatible = "hisi,l2-retention-dis-freq";
		dis_retention_cluster = <0x01>;
		dis_retention_freq = <0x240a90>;
		dis_retention_mask = <0x00 0x07>;
		dis_retention_value = <0x00 0x00>;
	};

	freq_hw_vote_reg {
		compatible = "hisi,freq-hw-vote-cpu";
		vote_channel_num = <0x02>;
		vote_reg_info = <0x00 0x280 0xff 0xff0000 0x2dc 0xff00 0x00 0x270 0xff 0xff0000 0x2dc 0xff>;
	};

	hisi,memlat-cpu4@fff31000 {
		compatible = "hisi,devbw";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		governor = "performance";
		reg = <0x00 0xfff31000 0x00 0x1000>;
		hisi,vote-reg = <0x2bc 0xff>;
		hisi,freq-tbl = <0x19f 0x33e 0x4dc 0x74a>;
	};

	hisi,arm-memlat-mon-4 {
		compatible = "hisi,arm-memlat-mon";
		hisi,switch-on-cpufreq = <0x674>;
		idle-vote-enabled;
		hisi,core-dev-table = <0xa6810 0x19f 0x193520 0x4dc 0x23e380 0x4dc 0x240a90 0x74a>;
		phandle = <0x1d>;
	};

	cpu_lowtemp {
		compatible = "hisi,cpu-lowtemp";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		reg = <0x00 0xfff31000 0x00 0x1000>;
		hisi,lowtemp-reg = <0x350>;
		hisi,lowtemp-reg-offset = <0x1a>;
	};

	hw_connectivity {
		compatible = "huawei,hw_connectivity";
