/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "kirin970";
	compatible = "hisilicon,kirin970";
	interrupt-parent = <0x01>;
	hisi,camera_arch_csudp = "platform_cs_udp";

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x400000 0x00 0xbfe00000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		camera-mem {
			size = <0x00 0x12c00000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x01 0x00 0x01 0x00>;
			compatible = "mm-camera-pool";
			reusable;
			status = "disable";
			visible_to_users;
		};

		hisi_cma {
			reg = <0x00 0x5a000000 0x00 0x26000000>;
			compatible = "mm-cma-pool";
			sec-attr = <0x00 0x20>;
			svc-id = <0x00 0x2b>;
			reusable;
			status = "ok";
			visible_to_users;
		};

		logo-buffer {
			reg = <0x00 0x10600000 0x00 0x3000000>;
			status = "disabled";
			visible_to_users;
		};

		supersonic {
			reg = <0x00 0x13600000 0x00 0x9b0000>;
			compatible = "hisi-supersonic";
			no-map;
			status = "disabled";
		};

		fingerprint-dma {
			reg = <0x00 0x13fb0000 0x00 0x50000>;
			compatible = "fingerprint,dma";
			no-map;
			status = "disabled";
		};

		iommu_pgtable {
			reg = <0x00 0x14000000 0x00 0x200000>;
			no-map;
		};

		hhee {
			reg = <0x00 0x14200000 0x00 0x600000>;
			no-map;
			status = "ok";
		};

		modem-socp {
			reg = <0x00 0x14800000 0x00 0x2000000>;
			no-map;
			status = "disabled";
		};

		fastboot-cma-mem {
			reg = <0x00 0x16800000 0x00 0x5c00000>;
			compatible = "shared-dma-pool";
			sec-attr = <0x00 0x00>;
			hisi,cma-sec;
			linux,cma-default;
			reusable;
			status = "ok";
			visible_to_users;
		};

		ivp {
			reg = <0x00 0x1cd00000 0x00 0x100000>;
			no-map;
		};

		secos {
			reg = <0x00 0x1ce00000 0x00 0x3000000>;
			no-map;
		};

		bl31 {
			reg = <0x00 0x1fe00000 0x00 0x400000>;
			no-map;
		};

		sensorhub-s {
			reg = <0x00 0x20200000 0x00 0x700000>;
			no-map;
		};

		sensorhub-shmem {
			reg = <0x00 0x20900000 0x00 0x40000>;
			no-map;
		};

		sensorhub-share-mem {
			reg = <0x00 0x20940000 0x00 0x80000>;
			no-map;
		};

		fka-mem {
			reg = <0x00 0x209c0000 0x00 0x3f000>;
			no-map;
		};

		mntndump {
			reg = <0x00 0x209ff000 0x00 0x1000>;
			no-map;
		};

		pstore-mem {
			reg = <0x00 0x20a00000 0x00 0x100000>;
		};

		dp-dhcp {
			reg = <0x00 0x20b00000 0x00 0x100000>;
			no-map;
		};

		modem-sa {
			reg = <0x00 0x38000000 0x00 0x8000000>;
			no-map;
			status = "disabled";
		};

		modem-s {
			reg = <0x00 0x80000000 0x00 0xa380000>;
			no-map;
		};

		secos-ex {
			reg = <0x00 0x8c080000 0x00 0x480000>;
			compatible = "hisi-secos-ex";
			no-map;
		};

		voiceid {
			reg = <0x00 0x8c500000 0x00 0x500000>;
			compatible = "hisi-voiceid";
			no-map;
		};

		sec_camera {
			reg = <0x00 0x8ca00000 0x00 0xb00000>;
			no-map;
			status = "ok";
		};

		hifi-base {
			reg = <0x00 0x8d500000 0x00 0xc00000>;
			no-map;
		};

		lpmx-core {
			reg = <0x00 0x8e100000 0x00 0x100000>;
			no-map;
		};

		lpmcu {
			reg = <0x00 0x8e200000 0x00 0x40000>;
			no-map;
		};

		align-reserved {
			reg = <0x00 0x8e240000 0x00 0xc0000>;
			no-map;
		};

		hifi-data {
			reg = <0x00 0x8e300000 0x00 0x500000>;
			no-map;
		};

		modem-share-mem {
			reg = <0x00 0x8e800000 0x00 0xb00000>;
			no-map;
		};

		modem-mntn {
			reg = <0x00 0x8f400000 0x00 0x100000>;
			no-map;
			status = "ok";
		};

		bbox-mem {
			reg = <0x00 0x8f500000 0x00 0x800000>;
			no-map;
		};

		kerneldump {
			reg = <0x00 0x8fd00000 0x00 0x20000000>;
			status = "disabled";
			visible_to_users;
		};

		app_no_allocate {
			reg = <0x00 0x00 0x00 0x1000>;
		};

		badpage-one {
			reg = <0x02 0x00 0x00 0x1000>;
			bad-range = <0x00 0x30000000 0x00 0x40000000 0x00 0xb0000000 0xffffffff 0xffffffff>;
			no-map;
			status = "disabled";
		};

		badpage-two {
			reg = <0x02 0x00 0x00 0x1000>;
			bad-range = <0x00 0x30000000 0x00 0x40000000 0x00 0xb0000000 0xffffffff 0xffffffff>;
			no-map;
			status = "disabled";
		};

		dtb {
			reg = <0x00 0x37e00000 0x00 0x200000>;
			status = "disabled";
		};

		normal-ramdisk {
			reg = <0x00 0x37600000 0x00 0x800000>;
			status = "disabled";
		};

		recovery-ramdisk {
			reg = <0x00 0x8fd00000 0x00 0x20000000>;
			status = "disabled";
		};

		xmode-data {
			size = <0x00 0x1f400000>;
			alignment = <0x00 0x100000>;
			alloc-ranges = <0x00 0x00 0x01 0x00>;
			compatible = "modem_xmode_region";
			region-name = "xmode-data";
			status = "disabled";
		};

		dmss_pt {
			size = <0x00 0x20000000>;
			compatible = "dmsspt_trace_buffer";
			no-map;
			status = "disable";
		};

		mperf {
			size = <0x00 0x900000>;
			alignment = <0x00 0x800000>;
			alloc-ranges = <0x00 0x00 0x01 0x00>;
			compatible = "hisi_mperf";
			status = "disable";
		};

		mdmlog {
			size = <0x00 0x3200000>;
			alignment = <0x00 0x100000>;
			alloc-ranges = <0x00 0x00 0x01 0x00>;
			compatible = "hisi_mdmlog";
			status = " ok";
		};
	};

	fastboot_pmic {
		compatible = "fastboot,hisi-pmic";
		hisilicon,init-reg-num = <0x00>;
		hisilicon,init-reg-addrs = <0x00>;
		hisilicon,init-reg-vals = <0x00>;
	};

	fastboot_pmic_mntn {
		compatible = "fastboot,hisi-pmic-mntn";
		hisilicon,data-width = <0x08>;
		hisilicon,record-reg-num = <0x0f>;
		hisilicon,record-regs = <0x222 0x223 0x224 0x225 0x226 0x227 0x228 0x229 0x22a 0x22b 0x22c 0x22d 0x22e 0x22f 0x230>;

		RECORD@222 {
			compatible = "hisilicon,pmic-mntn-record-reg0x222";
			hisilicon,inacceptable-event = <0xff>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08>;
			hisilicon,event-bit-name = "ocp_buck7", "ocp_buck6", "ocp_buck5", "ocp_buck4", "ocp_buck3", "ocp_buck2", "ocp_buck1", "ocp_buck0";
		};

		RECORD@223 {
			compatible = "hisilicon,pmic-mntn-record-reg0x223";
			hisilicon,inacceptable-event = <0x1f>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x00 0x00 0x00>;
			hisilicon,except-subtype = <0x09 0x0a 0x0b 0x0c 0x0d 0x00 0x00 0x00>;
			hisilicon,event-bit-name = "ocp_ldo3", "ocp_ldo2", "ocp_ldo1", "ocp_ldo0_2", "ocp_buck8", "reserved", "reserved", "reserved";
		};

		RECORD@224 {
			compatible = "hisilicon,pmic-mntn-record-reg0x224";
			hisilicon,inacceptable-event = <0xf8>;
			hisilicon,except-type = <0x00 0x00 0x00 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x00 0x00 0x00 0x0e 0x0f 0x10 0x11 0x12>;
			hisilicon,event-bit-name = "ocp_ldo12", "ocp_ldo11", "ocp_ldo9", "ocp_ldo8", "ocp_ldo7", "ocp_ldo6", "ocp_ldo5", "ocp_ldo4";
		};

		RECORD@225 {
			compatible = "hisilicon,pmic-mntn-record-reg0x225";
			hisilicon,inacceptable-event = <0xef>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x00 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x13 0x14 0x15 0x16 0x00 0x17 0x18 0x19>;
			hisilicon,event-bit-name = "ocp_ldo20", "ocp_ldo19", "ocp_ldo18", "ocp_ldo17", "ocp_ldo16", "ocp_ldo15", "ocp_ldo14", "ocp_ldo13";
		};

		RECORD@226 {
			compatible = "hisilicon,pmic-mntn-record-reg0x226";
			hisilicon,inacceptable-event = <0xff>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21>;
			hisilicon,event-bit-name = "ocp_ldo28", "ocp_ldo27", "ocp_ldo26", "ocp_ldo25", "ocp_ldo24", "ocp_ldo23", "ocp_ldo22", "ocp_ldo21";
		};

		RECORD@227 {
			compatible = "hisilicon,pmic-mntn-record-reg0x227";
			hisilicon,inacceptable-event = <0x7f>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x00>;
			hisilicon,except-subtype = <0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x00>;
			hisilicon,event-bit-name = "ocp_ldo36", "ocp_ldo35", "ocp_ldo34", "ocp_ldo33", "ocp_ldo32", "ocp_ldo30", "ocp_ldo29", "reserved";
		};

		RECORD@228 {
			compatible = "hisilicon,pmic-mntn-record-reg0x228";
			hisilicon,inacceptable-event = <0xff>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30>;
			hisilicon,event-bit-name = "scp_buck7", "scp_buck6", "scp_buck5", "scp_buck4", "scp_buck3", "scp_buck2", "scp_buck1", "scp_buck0";
		};

		RECORD@229 {
			compatible = "hisilicon,pmic-mntn-record-reg0x229";
			hisilicon,inacceptable-event = <0x03>;
			hisilicon,except-type = <0x01 0x01 0x00 0x00 0x00 0x00 0x00 0x00>;
			hisilicon,except-subtype = <0x31 0x32 0x00 0x00 0x00 0x00 0x00 0x00>;
			hisilicon,event-bit-name = "scp_ldobuff", "scp_buck8", "reserved", "reserved", "reserved", "reserved", "reserved", "reserved";
		};

		RECORD@22a {
			compatible = "hisilicon,pmic-mntn-record-reg0x22A";
			hisilicon,inacceptable-event = <0xdf>;
			hisilicon,except-type = <0x04 0x04 0x04 0x10 0x10 0x00 0x10 0x10>;
			hisilicon,except-subtype = <0x01 0x02 0x04 0x00 0x00 0x00 0x00 0x00>;
			hisilicon,event-bit-name = "vsys_ov", "vsys_pwroff_abs", "vsys_pwroff_deb", "thsd_otmp140", "thsd_otmp125", "hresetn", "avdd_osc_vld", "19m2_dis";
		};

		RECORD@22b {
			compatible = "hisilicon,pmic-mntn-record-reg0x22B";
			hisilicon,inacceptable-event = <0x07>;
			hisilicon,except-type = <0x20 0x08 0x20 0x00 0x00 0x00 0x00 0x00>;
			hisilicon,except-subtype = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			hisilicon,event-bit-name = "press8s_restart", "pwrhold_shutdown", "press8s_shutdown", "pwrhold_pwrup", "alarm_pwrup", "vbus_pwrup", "press40ms_pwrup", "fast_pwrup";
		};

		RECORD@22c {
			compatible = "hisilicon,pmic-mntn-record-reg0x22C";
			hisilicon,inacceptable-event = <0x38>;
			hisilicon,except-type = <0x00 0x00 0x00 0x02 0x10 0x01 0x00 0x00>;
			hisilicon,except-subtype = <0x00 0x00 0x00 0x00 0x00 0x33 0x00 0x00>;
			hisilicon,event-bit-name = "dcxo_sel_r", "dcxo_sel_f", "vsys_vcoin_sel", "smpl", "core_io_vld_f", "sys_nrst_4s", "reserved", "reserved";
		};

		RECORD@22d {
			compatible = "hisilicon,pmic-mntn-record-reg0x22D";
			hisilicon,inacceptable-event = <0x0f>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x00 0x00 0x00 0x00>;
			hisilicon,except-subtype = <0x34 0x35 0x36 0x37 0x00 0x00 0x00 0x00>;
			hisilicon,event-bit-name = "pmua_short_f", "ldo35_short_f", "vin_ldoh_shutdown", "pwronexp_shutdown", "reserved", "reserved", "reserved", "reserved";
		};

		RECORD@22e {
			compatible = "hisilicon,pmic-mntn-record-reg0x22E";
			hisilicon,inacceptable-event = <0xff>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x04 0x04>;
			hisilicon,except-subtype = <0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x08 0x10>;
			hisilicon,event-bit-name = "cali_ldo35_ocp", "cali_ldo26_ocp", "cali_buck3_scp", "cali_buck3_ocp", "cali_ldo35_short", "cali_pmua_short", "cali_vsyspwroff_deb", "cali_vsyspwroff_abs";
		};

		RECORD@22f {
			compatible = "hisilicon,pmic-mntn-record-reg0x22F";
			hisilicon,inacceptable-event = <0x0f>;
			hisilicon,except-type = <0x10 0x10 0x10 0x04 0x00 0x00 0x00 0x00>;
			hisilicon,except-subtype = <0x00 0x00 0x00 0x20 0x00 0x00 0x00 0x00>;
			hisilicon,event-bit-name = "cali_avdd_osc_vld", "cali_thsd_otmp140", "cali_thsd_otmp125", "cali_vsys_ov", "reserved", "reserved", "reserved", "reserved";
		};

		RECORD@230 {
			compatible = "hisilicon,pmic-mntn-record-reg0x230";
			hisilicon,inacceptable-event = <0x1f>;
			hisilicon,except-type = <0x20 0x01 0x01 0x01 0x01 0x00 0x00 0x00>;
			hisilicon,except-subtype = <0x00 0x3e 0x3f 0x40 0x41 0x00 0x00 0x00>;
			hisilicon,event-bit-name = "pwron_hrst", "ramp_buck0", "ramp_buck4", "ramp_buck5", "ramp_buck6", "reserved", "reserved", "reserved";
		};
	};

	fastboot_core {
		compatible = "fastboot,coul";
		coul_type = <0x05>;
		status = "ok";
	};

	slimbusmisc@0xe8050000 {
		compatible = "candance,slimbus";
		reg = <0x00 0xe8050000 0x00 0xb00 0x00 0xe804e000 0x00 0xa000 0x00 0xfff0a000 0x00 0x1000>;
		interrupts = <0x00 0x96 0x04>;
		interrupt-names = "asp_irq_slimbus";
		slimbus-reg-supply = <0x02>;
		clk_asp_subsys = <0x65518>;
		asp_power_state_offset = <0x6c>;
		asp_clk_state_offset = <0x16c>;
		status = "ok";
		pinctrl-names = "default", "idle";
		pinctrl-0 = <0x03 0x04 0x05 0x06>;
		pinctrl-1 = <0x07 0x08 0x09 0x0a>;
		slimbus-ssi-sel = "slimbus";
		slimbusclk_offset = <0x38>;
		slimbusdata_offset = <0x3c>;
		slimbusclk_cfg_offset = <0x864>;
		slimbusdata_cfg_offset = <0x868>;
		platform-type = "ASIC";
		codec-type = "slimbus-da_combine_v3cs";
		slimbus_dynamic_freq = "true";
		pm_runtime_support;
	};

	codecssi@0xe82b9000 {
		compatible = "hisilicon,codecssi";
		reg = <0x00 0xe82b9000 0x00 0x800>;
		pinctrl-names = "default", "idle";
		pinctrl-0 = <0x0b 0x0c>;
		pinctrl-1 = <0x0d 0x0e>;
		status = "disabled";
	};

	ddr_devfreq@fffc0000 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "hisilicon,ddr_devfreq";
		reg = <0x00 0xfffc0000 0x00 0x10000>;
		pm_qos_data_reg = <0x10 0x3c>;
		clocks = <0x0f 0x10>;
		pm_qos_class = "memory_tput";
		operating-points = <0x65518 0x00 0xcaa30 0x00 0x12fb60 0x00 0x1c7910 0x00>;
		vote_method = "hardware";
		status = "ok";
	};

	huawei,lcd_panel {
		compatible = "huawei,lcd_panel_type";
	};

	panel_lcd_lg_S6E3HF4_5P5 {
	};

	panel_lcd_samsung_S6E3HF4_5P5 {
	};

	panel_lcd_lg_TD4322_6P0 {
	};

	panel_lcd_sharp_TD4322_6P0 {
	};

	panel_lcd_jdi_R63452_6P0 {
	};

	ddr_devfreq_up_threshold@fffc0000 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "hisilicon,ddr_devfreq";
		reg = <0x00 0xfffc0000 0x00 0x10000>;
		pm_qos_data_reg = <0x10 0x3c>;
		clocks = <0x11 0x10>;
		pm_qos_class = "memory_tput_up_threshold";
		operating-points = <0x65518 0x00 0xcaa30 0x00 0x12fb60 0x00 0x1c7910 0x00>;
		vote_method = "hardware";
		status = "ok";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x00>;
			clocks = <0x12 0x00>;
			clock-names = "cpu-cluster.0";
			freq-vote-channel = "little-freq", "vote-src-1";
			enable-method = "psci";
			clock-frequency = <0x00>;
			clock-latency = <0x00>;
			cpu-idle-states = <0x13 0x14>;
			operating-points-v2 = <0x15>;
			sched-energy-costs = <0x16 0x17>;
			capacity-dmips-mhz = <0x1ce>;
			phandle = <0x1e>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x01>;
			clocks = <0x12 0x00>;
			clock-names = "cpu-cluster.0";
			freq-vote-channel = "little-freq", "vote-src-1";
			enable-method = "psci";
			clock-frequency = <0x00>;
			clock-latency = <0x00>;
			cpu-idle-states = <0x13 0x14>;
			operating-points-v2 = <0x15>;
			sched-energy-costs = <0x16 0x17>;
			capacity-dmips-mhz = <0x1ce>;
			phandle = <0x1f>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x02>;
			clocks = <0x12 0x00>;
			clock-names = "cpu-cluster.0";
			freq-vote-channel = "little-freq", "vote-src-1";
			enable-method = "psci";
			clock-frequency = <0x00>;
			clock-latency = <0x00>;
			cpu-idle-states = <0x13 0x14>;
			operating-points-v2 = <0x15>;
			sched-energy-costs = <0x16 0x17>;
			capacity-dmips-mhz = <0x1ce>;
			phandle = <0x20>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x03>;
			clocks = <0x12 0x00>;
			clock-names = "cpu-cluster.0";
			freq-vote-channel = "little-freq", "vote-src-1";
			enable-method = "psci";
			clock-frequency = <0x00>;
			clock-latency = <0x00>;
			cpu-idle-states = <0x13 0x14>;
			operating-points-v2 = <0x15>;
			sched-energy-costs = <0x16 0x17>;
			capacity-dmips-mhz = <0x1ce>;
			phandle = <0x21>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
