	a1@0xFF012000 {
		clocks = <0x1e0 0x1e1 0x1e2>;
		phandle = <0x670>;
	};

	psci {
		phandle = <0x671>;
	};

	hisi,memlat-cpu4@fff31000 {
		phandle = <0x245>;
	};

	hisi,arm-memlat-mon-4 {
		hisi,target-dev = <0x245>;
	};

	hw_connectivity {
		phandle = <0x672>;
	};

	hi1102 {
		compatible = "hisilicon,hi1102";
		huawei,pmu_clk32b = "pmu_clk32kb";
		hi1102,gpio_power_on = <0x1d6 0x07 0x00>;
		pinctrl-names = "default", "idle";
		pinctrl-0 = <0x246 0x247 0x248 0x249 0x24a 0x24b>;
		pinctrl-1 = <0x24c 0x24d 0x24e 0x24f 0x250 0x251>;
		hi1102,asic_version;
		hi1102,power_prepare;
		hi1102,gpio_xldo_pinmux = <0x5a 0x05 0x00>;
		xldo_gpio_level = <0x01>;
		phandle = <0x673>;
	};

	hisi_wifi {
		compatible = "hisilicon,hisi_wifi";
		hi1102,gpio_wlan_wakeup_host = <0x2b 0x05 0x00>;
		phandle = <0x674>;

		hisi_wifi_firmware {
			compatible = "hisi,wifi_firmware";
			firmware_type_num = "1";
		};

		hisi_wifi_supp {
			compatible = "hisi,wifi_supp";
			supp_config_template = "/vendor/etc/wifi/wpa_supplicant_hisi.conf";
		};

		hisi_wifi_p2p {
			compatible = "hisi,wifi_p2p";
			p2p_config_template = "/vendor/etc/wifi/p2p_supplicant_hisi.conf";
		};

		hisi_wifi_apd {
			compatible = "hisi,wifi_hostapd";
			hostapd_bin_file = "/vendor/bin/hostapd_hisi";
		};
	};

	hisi_bfgx {
		compatible = "hisilicon,hisi_bfgx";
		hi1102,gpio_bfgn_wakeup_host = <0x232 0x02 0x00>;
		hi1102,uart_port = "/dev/ttyAMA4";
		hi1102,uart_pclk_normal;
		phandle = <0x675>;
	};

