/ {
	hisi,product_name = "BLANC-LX9";

	sensorhub {
		sar {
			sar1 {
				status = "ok";
			};

			sar2 {
				status = "ok";
			};
		};

		rpc {
			phandle = <0x588>;

			rpc {
				compatible = "huawei,rpc";
				file_id = <0x18>;
				sensor_list_info_id = <0x18>;
				sensor_type = "rpc";
				sensorlist_name = "rpc";
				mask = <0x0f 0x63f 0x63f 0x63f 0x63e 0x63c 0x63e 0x63c 0x63e 0x63c 0x20f 0x20f 0x20f 0x20f 0x20f 0x20f 0x20f 0x20f 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff>;
				table = <0x00 0x217 0x227 0x207 0x212 0x214 0x222 0x224 0x202 0x204 0x201 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff 0xffff>;
				default_value = <0x1d>;
				status = "ok";
			};
		};
	};

